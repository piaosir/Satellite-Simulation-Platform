  "build": {
    "appId": "com.satsim.platform",
    "productName": "卫星仿真平台",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://update-1385987144.cos.ap-beijing.myqcloud.com/updates/"
      }
    ],
    "files": [
      "out/**/*",
      "electron/**/*",
      "packages/**/*",
      "!packages/core/test/**",
      "resources/**/*",
      "!resources/imagery/**",
      "!resources/models/**",
      "!resources/licenses/**",
      "package.json",
      "!node_modules/cesium/**/*",
      "!node_modules/three/**/*",
      "!node_modules/occt-import-js/test/**",
      "!node_modules/occt-import-js/examples/**",
      "!node_modules/occt-import-js/occt-import-js/**",
      "!node_modules/occt-import-js/tools/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "卫星仿真平台",
      "artifactName": "卫星仿真平台-${version}-Setup.${ext}",
      "preCompressedFileExtensions": []
    },
    "extraResources": [
      {
        "from": "resources/imagery",
        "to": "imagery",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "@gltf-transform/functions": "^4.5.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "sharp": "^0.35.4",
    "topojson-server": "^3.0.1",
    "undici": "^7.29.1",
    "vite": "^5.3.1",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-static-copy": "^1.0.6"
  }
}
