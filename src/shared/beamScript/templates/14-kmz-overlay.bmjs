//! id: kmz-overlay
//! name: ⟪KMZ · 分级填色地面叠加层|KMZ · Graded-fill ground overlay⟫
//! ext: kmz
//zh 分级填色：等值线由外向内逐档填色，渲染为 PNG（等经纬度栅格），作为 Google Earth 地面叠加层（GroundOverlay）打包进 KMZ。
//en Graded fill: contours painted outside-in onto a plate-carrée PNG and packed into a KMZ as a Google Earth GroundOverlay.

const WIDTH = 2048      // ⟪图像宽度（像素）|image width (px)⟫
const OPACITY = 0.7     // ⟪叠加不透明度|overlay opacity⟫

const bb = geo.bbox(data.beams)
if (!bb) return console.warn('⟪暂无等值线|No contours⟫')
// ⟪跨日界线时 east > 180（KML LatLonBox 允许）|east > 180 when crossing the antimeridian (allowed in a KML LatLonBox)⟫
const [west, south, east, north] = bb
const height = Math.max(64, Math.round(WIDTH * (north - south) / Math.max(east - west, 1e-6)))

const img = await png('overlay.png', WIDTH, height, (ctx) => {
  const p = geo.fit(bb, WIDTH, height, 0)
  // ⟪低电平（外圈）先绘制，高电平覆盖其上|lower (outer) levels first, higher ones on top⟫
  const all = data.beams.flatMap((b) => b.contours).sort((a, b) => a.level - b.level)
  for (const c of all) {
    ctx.beginPath()
    c.points.forEach((q, i) => { const [x, y] = p.point(q); if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y) })
    ctx.closePath()
    ctx.fillStyle = c.color
    ctx.fill()
  }
})

const alpha = color.kml('#ffffff', OPACITY)
const doc = `<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<GroundOverlay>
<name>${xml.esc('⟪波束覆盖|Beam coverage⟫')}</name>
<color>${alpha}</color>
<Icon><href>overlay.png</href></Icon>
<LatLonBox><north>${north}</north><south>${south}</south><east>${east}</east><west>${west}</west></LatLonBox>
</GroundOverlay>
</kml>
`
return zip('⟪波束覆盖_叠加|beam_overlay⟫.kmz', [file('doc.kml', doc), img])
