{
  "meta": {
    "table": "RR Article 21, Section V, Table 21-4 (Rev.WRC-23) - Limits of power flux-density from space stations",
    "source": "ITU Radio Regulations, Edition of 2024, Volume 1 - Articles, pp. RR21-6..RR21-14 (PDF pages 296-304 of 2400594-RR-Vol 1-E-A5.pdf)",
    "sourceUrl": "https://www.itu.int/dms_pub/itu-r/opb/reg/R-REG-RR-2024-ZPF-E.zip",
    "sourceSha256": "a19db60201342f44443143c01c528abe725b93cf133602631edaa2b6c9ba6a8f",
    "extractedOn": "2026-10-17",
    "extraction": "Row-by-row hand transcription from page renders (PyMuPDF, 2.2x and 4x crops), then checked cell by cell against an independent pdfplumber line-grid extraction and a pypdf text dump of the same pages: every printed band edge, reference bandwidth, delta breakpoint and formula agrees (see packages/core/test/art21Table.test.mjs).",
    "rule": "No. 21.16: the limit relates to the pfd which would be obtained under assumed free-space propagation conditions; it applies to emissions of a space station of the service indicated where the bands are shared with equal rights with the fixed or mobile service, unless otherwise stated. No. 21.17: the limits may be exceeded on the territory of any country whose administration has so agreed.",
    "units": "limit in dB(W/m2) in the reference bandwidth refBwHz; delta = angle of arrival above the horizontal plane, degrees",
    "segmentConvention": "a segment applies for from < delta <= to (the first segment of a limit also includes from); value = a + slope*(delta - d0) + logK*log10(delta - logD0) + F*(funcCoef + funcSlope*(delta - d0)), F = X (No. 21.16.6) or Y (No. 21.16.15) when func is given, absent terms are 0",
    "bandConvention": "band edges inclusive; a row applies to every listed service in every listed band (the 2 500-2 690 MHz row prints bands and services side by side, which gives the same limits for each pairing); region / country qualifiers belong to the band entry they are printed under",
    "orbitConvention": "orbit null = no orbit qualifier printed; hio = non-GSO space station with apogee altitude > 18 000 km and inclination 35-145 deg (Nos. 21.16.6B, 21.16.6C, 21.16.17)",
    "footnoteMarks": { "7": "21.16.1", "8": "21.16.2", "9": "21.16.3", "10": "21.16.3A", "11": "21.16.4", "12": "21.16.5", "13": "21.16.6", "14": "21.16.6A", "15": "21.16.6B", "16": "21.16.6C", "17": "21.16.7", "18": "21.16.8", "19": "21.16.9", "20": "21.16.10", "21": "21.16.14", "22": "21.16.15", "23": "21.16.16", "24": "21.16.17", "25": "21.16.18", "26": "21.16.19" },
    "notCrossChecked": "RR 2020 edition not compared (no local copy); WRC-23 revised Nos. 21.16.6, 21.16.6A, 21.16.6C and added the 27.5-30.0 GHz inter-satellite row (No. 21.16.19)"
  },
  "footnotes": {
    "21.16.1": { "mark": 7, "version": "", "effect": "info", "text": "Equality of right to operate between Regions is established in No. 4.8; inter-Regional limits in ITU-R Recommendations should, as far as practicable, be observed." },
    "21.16.2": { "mark": 8, "version": "WRC-2000", "effect": "additional-limit", "text": "In addition, in 18.6-18.8 GHz the pfd across the 200 MHz band 18.6-18.8 GHz produced at the surface of the Earth by emissions from a space station under assumed free-space propagation conditions shall not exceed -95 dB(W/m2), except for less than 5% of time, when the limit may be exceeded by up to 3 dB. No. 21.17 does not apply in this band.", "additionalLimit": { "lowMHz": 18600, "highMHz": 18800, "services": ["FSS"], "limit": -95, "refBwHz": 200000000, "exceedPctTime": 5, "exceedDb": 3 } },
    "21.16.3": { "mark": 9, "version": "", "effect": "info", "text": "Derived to protect line-of-sight fixed service; for troposcatter fixed service sufficient angular separation is needed so that interference at the fixed-service receiver input does not exceed -168 dBW in any 4 kHz band." },
    "21.16.3A": { "mark": 10, "version": "WRC-19", "effect": "info", "text": "Resolution 903 (Rev.WRC-19) shall apply." },
    "21.16.4": { "mark": 11, "version": "WRC-2000", "effect": "condition", "text": "The values apply to space stations of non-geostationary satellites in systems operating with 99 or fewer satellites; further study is needed to apply them to systems with 100 or more satellites." },
    "21.16.5": { "mark": 12, "version": "", "effect": "condition", "text": "Applicable where this band is shared with equal rights with the meteorological aids service." },
    "21.16.6": { "mark": 13, "version": "WRC-23", "effect": "function", "text": "Defines X(N, Nv). In 18.8-19.3 GHz these limits apply to any non-GSO space station in the FSS for which complete coordination or notification information was received by the Bureau since 17 November 1995 and which was not operational by that date, and in the inter-satellite service." },
    "21.16.6A": { "mark": 14, "version": "WRC-23", "effect": "condition", "text": "These limits apply to space stations in the meteorological-satellite service and to geostationary satellites in the FSS and inter-satellite services; also to non-GSO FSS space stations in 18.8-19.3 GHz whose complete coordination or notification information was received by 17 November 1995, or which were in operation by that date." },
    "21.16.6B": { "mark": 15, "version": "WRC-07", "effect": "condition", "text": "These limits also apply to FSS space stations using highly-inclined orbits (apogee > 18 000 km, inclination 35-145 deg) in 17.7-19.7 GHz to which Resolution 147 (WRC-07) applies." },
    "21.16.6C": { "mark": 16, "version": "WRC-23", "effect": "condition", "text": "These limits apply to all space stations using highly-inclined orbits (apogee > 18 000 km, inclination 35-145 deg) in 17.7-19.7 GHz in the FSS not covered by Resolution 147 (WRC-07) whose complete coordination or notification information was received after 16 November 2007, and in the inter-satellite service." },
    "21.16.7": { "mark": 17, "version": "", "effect": "info", "text": "Subject to review by ITU-R; apply until revised by a competent world radiocommunication conference." },
    "21.16.8": { "mark": 18, "version": "WRC-15", "effect": "info", "text": "EESS (active) values are mean pfd values: pfd(delta) = P + 10log(tau) + 10log(PRF) - 30 - 10log(Bc) + Gt(delta) - 10log(4 pi d(delta)^2)." },
    "21.16.9": { "mark": 19, "version": "WRC-15", "effect": "info", "text": "Also based on sharing with the Earth exploration-satellite (active) and space research services." },
    "21.16.10": { "mark": 20, "version": "WRC-2000", "effect": "additional-limit", "text": "During the launch and near-Earth operational phase of deep-space facilities, non-GSO space research systems shall not exceed -115 dB(W/m2) for delta < 5 deg, -115 + 0.5(delta - 5) for 5 <= delta <= 25 deg, -105 for delta > 25 deg, in any 1 MHz band." },
    "21.16.14": { "mark": 21, "version": "WRC-03", "effect": "info", "text": "In 37.5-40 GHz and 40.5-42.5 GHz the pfd from any FSS satellite should be no greater than required to meet FSS link availability and performance objectives; in any case it shall not exceed the limits of Table 21-4." },
    "21.16.15": { "mark": 22, "version": "WRC-03", "effect": "function", "text": "Defines Y(NN, NS)." },
    "21.16.16": { "mark": 23, "version": "WRC-03", "effect": "info", "text": "Applicability may need review by a future conference if more than five co-frequency non-GSO systems are simultaneously operating in the same hemisphere." },
    "21.16.17": { "mark": 24, "version": "WRC-03", "effect": "condition", "text": "These limits apply to non-GSO FSS space stations with inclination between 35 and 145 deg and apogee altitude greater than 18 000 km." },
    "21.16.18": { "mark": 25, "version": "WRC-03", "effect": "condition", "text": "These limits apply to non-GSO FSS space stations not covered by No. 21.16.17." },
    "21.16.19": { "mark": 26, "version": "WRC-23", "effect": "info", "text": "The methodology in Annex 2 to Resolution 679 (WRC-23) shall be applied to calculate the pfd from a non-GSO space station transmitting in 27.5-30.0 GHz." }
  },
  "functions": {
    "X": {
      "provision": "21.16.6",
      "version": "WRC-23",
      "args": {
        "N": "number of satellites in the non-geostationary satellite constellation in the fixed-satellite service",
        "Nv": "maximum number of visible space stations (minimum elevation 0 deg) from any location on the surface of the Earth within the service area of the non-GSO system; does not depend on latitude; Nv = Max(Nv(j)), Nv(j) = Max(Nv(j(t)), Nv(j(t-1)))"
      },
      "branches": [
        { "nMin": null, "nMinIncl": false, "nMax": 50, "nMaxIncl": true, "text": "X = 0 dB for N <= 50" },
        { "nMin": 50, "nMinIncl": false, "nMax": 288, "nMaxIncl": true, "text": "X = (5/119)(N - 50) dB for 50 < N <= 288" },
        { "nMin": 288, "nMinIncl": false, "nMax": 999, "nMaxIncl": true, "text": "X = (1/69)(N + 402) dB for 288 < N <= 999" },
        { "nMin": 1000, "nMinIncl": true, "nMax": 6000, "nMaxIncl": true, "text": "X = max{20.3; 10 log10(Nv)} dB for 1 000 <= N <= 6 000" },
        { "nMin": 6000, "nMinIncl": false, "nMax": null, "nMaxIncl": false, "text": "X = 10 log10(Nv) + 1 dB for N > 6 000" }
      ]
    },
    "Y": {
      "provision": "21.16.15",
      "version": "WRC-03",
      "args": {
        "NN": "maximum number of space stations in a system simultaneously transmitting on a co-frequency basis in the FSS in the Northern Hemisphere",
        "NS": "maximum number of space stations in the same system simultaneously transmitting on a co-frequency basis in the FSS in the Southern Hemisphere (two stations simultaneously transmitting during short-duration handover count as one)"
      },
      "branches": [
        { "text": "Y = 0 for max(NN, NS) <= 2" },
        { "text": "Y = 5 log(max(NN, NS)) for max(NN, NS) > 2" }
      ]
    }
  },
